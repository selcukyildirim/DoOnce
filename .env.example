# DoOnce enterprise configuration (never commit real secrets).
#
# Database: SQLite by default, Postgres for production/HA.
# DOONCE_DATABASE_URL=postgres://doonce:change-me@localhost:5432/doonce
DOONCE_DATABASE_URL=sqlite:///tmp/doonce.db?mode=rwc

# 32-byte master key, base64 encoded. In production use a KMS/HSM-backed key
# instead of a local file.
# DOONCE_MASTER_KEY=

# Deployment topology and data residency (saas, onprem, airgapped).
DOONCE_DEPLOYMENT_MODE=onprem
DOONCE_REGION=global

# Runtime
DOONCE_ENV=development
DOONCE_PUBLIC_URL=http://127.0.0.1:8080
DOONCE_COOKIE_SECURE=false
DOONCE_SESSION_TTL_SECS=28800
DOONCE_HOME=
DOONCE_LOG=info
DOONCE_TELEMETRY=false
DOONCE_BIND=127.0.0.1:8080
DOONCE_ARTIFACT_DIR=
DOONCE_HEADLESS=true
DOONCE_CHROME_PROFILE=
# Attach to an already running Chrome instead of launching one:
DOONCE_CDP_URL=
# Optional egress controls for anti-bot / geo requirements:
DOONCE_PROXY=
DOONCE_USER_AGENT=

# AI providers (keys are read from the environment only, never persisted)
DOONCE_LLM_PROVIDER=
DOONCE_LLM_MODEL=
DOONCE_LLM_BASE_URL=
DOONCE_LLM_API_KEY=
DOONCE_AI_PROVIDER=
DOONCE_AI_MODEL=
DOONCE_AI_BASE_URL=
DOONCE_AI_API_KEY=

# Hybrid data-plane connector (outbound-only)
DOONCE_CONTROL_URL=
DOONCE_CONNECTOR_TOKEN=
DOONCE_CONNECTOR_LOCAL_URL=http://127.0.0.1:8080
DOONCE_CONNECTOR_LOCAL_API_KEY=
DOONCE_CONNECTOR_AUTO_APPROVE=false
DOONCE_CONNECTOR_POLL_SECS=2
DOONCE_CONNECTOR_LEASE_SECS=900
