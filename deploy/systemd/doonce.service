[Unit]
Description=DoOnce control plane API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doonce
Group=doonce
EnvironmentFile=/etc/doonce/doonce.env
ExecStart=/usr/local/bin/doonce serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/doonce
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65535
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
