{
  "name": "doonce-extension",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-icons.mjs && node scripts/build-scripts.mjs && tsc --noEmit && vite build && node scripts/build-scripts.mjs",
    "build:scripts": "node scripts/build-scripts.mjs",
    "check-agent": "node scripts/build-scripts.mjs --check",
    "dev": "vite build --watch",
    "test": "vitest run --environment happy-dom",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
