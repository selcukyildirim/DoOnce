{
  "manifest_version": 3,
  "name": "DoOnce",
  "version": "0.1.0",
  "description": "Teach once. Run forever. Fix itself.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "downloads", "sidePanel", "webNavigation", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open DoOnce",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
