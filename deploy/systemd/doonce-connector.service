[Unit]
Description=DoOnce outbound hybrid connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doonce
Group=doonce
EnvironmentFile=/etc/doonce/connector.env
ExecStart=/usr/local/bin/doonce connector
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/doonce
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65535
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
